{
  "name": "@lithiumdevs/ai-inspector",
  "version": "0.1.0",
  "description": "Local-first traces for TypeScript AI apps: model calls, tokens, latency, tools, costs, and evals.",
  "license": "MIT",
  "author": "lithiumdevs",
  "homepage": "https://github.com/lithiumdevs/ai-inspector#readme",
  "repository": "git+https://github.com/lithiumdevs/ai-inspector.git",
  "bugs": "https://github.com/lithiumdevs/ai-inspector/issues",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18.17"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node/index.js",
      "require": "./dist/node/index.cjs"
    },
    "./otel": {
      "types": "./dist/otel/index.d.ts",
      "import": "./dist/otel/index.js",
      "require": "./dist/otel/index.cjs"
    },
    "./ai-sdk": {
      "types": "./dist/ai-sdk/index.d.ts",
      "import": "./dist/ai-sdk/index.js",
      "require": "./dist/ai-sdk/index.cjs"
    },
    "./openai": {
      "types": "./dist/openai/index.d.ts",
      "import": "./dist/openai/index.js",
      "require": "./dist/openai/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "ai-inspector": "./dist/cli.js"
  },
  "keywords": [
    "ai",
    "llm",
    "observability",
    "tracing",
    "opentelemetry",
    "vercel-ai-sdk",
    "openai",
    "evaluation",
    "typescript",
    "monitoring",
    "debugging",
    "local-first"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
